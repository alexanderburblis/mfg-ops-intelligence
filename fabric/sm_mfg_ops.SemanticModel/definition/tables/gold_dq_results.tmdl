		summarizeBy: none
		sourceColumn: owner

		annotation SummarizationSetBy = Automatic

	column corrective_action
		dataType: string
		lineageTag: 9f711158-bb43-5e36-b6f7-09c53edac71f
		summarizeBy: none
		sourceColumn: corrective_action

		annotation SummarizationSetBy = Automatic

	column rows_checked
		dataType: int64
		lineageTag: c5c7abe0-d793-5a27-b182-9bc79b9f1dc2
		summarizeBy: sum
		sourceColumn: rows_checked

		annotation SummarizationSetBy = Automatic

	column rows_failed
		dataType: int64
