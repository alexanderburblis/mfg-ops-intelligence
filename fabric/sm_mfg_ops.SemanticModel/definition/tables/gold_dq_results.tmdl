/// One row per data-quality rule per pipeline run.
table gold_dq_results
	lineageTag: 92a7f7a8-8ffd-5545-a860-e97a1f33c755

	measure 'Latest DQ Run' = MAX ( gold_dq_results[run_ts] )
		formatString: dd mmm hh:nn
		displayFolder: Data quality
		lineageTag: abb6d109-31ae-5be4-bccd-797b0dc6a4ba

	measure 'Rows Checked (latest run)' = VAR LastRun = MAXX ( ALL ( gold_dq_results ), gold_dq_results[run_id] ) RETURN CALCULATE ( SUM ( gold_dq_results[rows_checked] ), gold_dq_results[run_id] = LastRun )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 79284fb7-15d6-59da-be64-f5dbc2f25864

	measure 'Rows Failed (latest run)' = VAR LastRun = MAXX ( ALL ( gold_dq_results ), gold_dq_results[run_id] ) RETURN CALCULATE ( SUM ( gold_dq_results[rows_failed] ), gold_dq_results[run_id] = LastRun )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 9d07c0c3-f68e-591a-8746-5852da5a71c4

	/// Share of rule checks that passed in the latest run.
	measure 'DQ Pass Rate %' = 1 - DIVIDE ( [Rows Failed (latest run)], [Rows Checked (latest run)] )
		formatString: 0.00%
		displayFolder: Data quality
		lineageTag: 494c1530-f7b5-5856-8236-557132096cdd

	measure 'Rules Failing (latest run)' = VAR LastRun = MAXX ( ALL ( gold_dq_results ), gold_dq_results[run_id] ) RETURN CALCULATE ( COUNTROWS ( gold_dq_results ), gold_dq_results[run_id] = LastRun, gold_dq_results[rows_failed] > 0 )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: 8a367ebf-8a88-59b8-9930-c77eff3c4940

	/// Across the runs in the filter context.
	measure 'Rows Failed' = SUM ( gold_dq_results[rows_failed] )
		formatString: #,0
		displayFolder: Data quality
		lineageTag: d8226d98-d390-52b7-805b-d0137d101bf3

	/// Pass rate for the runs in the filter context, for trends.
	measure 'DQ Pass Rate per Run %' = 1 - DIVIDE ( SUM ( gold_dq_results[rows_failed] ), SUM ( gold_dq_results[rows_checked] ) )
		formatString: 0.00%
		displayFolder: Data quality
		lineageTag: 36441af1-fb95-5e65-8022-3aa0ee4dc4ee

	column run_id
		dataType: string
		lineageTag: d5c0a6b2-05a8-5adf-8c06-00b9ca2eb785
		summarizeBy: none
		sourceColumn: run_id

		annotation SummarizationSetBy = Automatic

	column run_ts
		dataType: dateTime
		formatString: yyyy-mm-dd hh:nn
		lineageTag: 39672c16-f7b7-5da7-8c37-c71ba79e9efb
		summarizeBy: none
		sourceColumn: run_ts

		annotation SummarizationSetBy = Automatic

	column rule_id
