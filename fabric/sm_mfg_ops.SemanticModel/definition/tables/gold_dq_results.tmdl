		summarizeBy: sum
		sourceColumn: rows_failed

		annotation SummarizationSetBy = Automatic

	partition gold_dq_results = entity
		mode: directLake
		source
			entityName: gold_dq_results
			schemaName: dbo
			expressionSource: DatabaseQuery
