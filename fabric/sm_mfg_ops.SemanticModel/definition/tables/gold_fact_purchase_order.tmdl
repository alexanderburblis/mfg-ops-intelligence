/// One row per purchase order line, with promised and receipt dates.
table gold_fact_purchase_order
	lineageTag: 24d40dd7-13f0-53c3-a367-6ef9105ee4b9

	measure 'Supplier On-Time %' = DIVIDE ( CALCULATE ( COUNTROWS ( gold_fact_purchase_order ), gold_fact_purchase_order[is_on_time] = TRUE () ), CALCULATE ( COUNTROWS ( gold_fact_purchase_order ), gold_fact_purchase_order[is_received] = TRUE () ) )
		formatString: 0.0%
		displayFolder: Purchasing
		lineageTag: 2451d2e9-c5be-59b9-89b8-e86ccc73a26a

	measure 'Avg Supplier Days Late' = CALCULATE ( AVERAGE ( gold_fact_purchase_order[days_late] ), gold_fact_purchase_order[days_late] > 0 )
		formatString: #,0.0
		displayFolder: Purchasing
		lineageTag: 793c9072-d35b-5f7b-b4cf-c22cda19600c

	measure 'Open Purchase Orders' = CALCULATE ( COUNTROWS ( gold_fact_purchase_order ), gold_fact_purchase_order[is_received] = FALSE () )
		formatString: #,0
		displayFolder: Purchasing
		lineageTag: 42df89df-3523-5465-8736-62c64c7ea22a

