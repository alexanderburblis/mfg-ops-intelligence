/// One row per pipeline run: mode, status, duration, volumes.
table meta_run_summary
	lineageTag: 3f0bc1d4-54f1-5618-90bb-f63a004d23ff

	measure Runs = COUNTROWS ( meta_run_summary )
		formatString: #,0
		displayFolder: Monitoring
		lineageTag: 44acae0c-db68-510a-a94e-6b8a5e506abb

	measure 'Failed Runs' = CALCULATE ( COUNTROWS ( meta_run_summary ), meta_run_summary[status] = "failed" )
		formatString: #,0
		displayFolder: Monitoring
		lineageTag: d54d449c-a336-54e2-96c8-6c60ff62037a

	measure 'Run Success Rate %' = DIVIDE ( [Runs] - [Failed Runs], [Runs] )
		formatString: 0.0%
		displayFolder: Monitoring
		lineageTag: 68227bf7-62f8-555f-b288-5bd9309b1332

	measure 'Avg Run Duration (s)' = AVERAGE ( meta_run_summary[seconds] )
		formatString: #,0
		displayFolder: Monitoring
		lineageTag: d9024cc6-c02b-59e5-81dd-fe3f246022e1

	measure 'Last Run Status' = VAR LastStart = MAX ( meta_run_summary[started_at] ) RETURN CALCULATE ( MAX ( meta_run_summary[status] ), meta_run_summary[started_at] = LastStart )
		displayFolder: Monitoring
		lineageTag: 27f71af3-9cb8-51b7-8625-cce2b7d669f6

	measure 'Last Successful Run' = CALCULATE ( MAX ( meta_run_summary[finished_at] ), meta_run_summary[status] = "success" )
		formatString: yyyy-mm-dd hh:nn
		displayFolder: Monitoring
		lineageTag: de16b938-7e85-5110-a247-aacb68f23451

	measure 'Rows Quarantined' = SUM ( meta_run_summary[rows_quarantined] )
		formatString: #,0
		displayFolder: Monitoring
		lineageTag: e00c871d-85c2-50cd-a1d3-4c1d4854b7d2

	column run_id
		dataType: string
		lineageTag: 72c0c165-7829-57c1-a0e3-ae76fe94e68d
		summarizeBy: none
		sourceColumn: run_id

		annotation SummarizationSetBy = Automatic

	column load_mode
