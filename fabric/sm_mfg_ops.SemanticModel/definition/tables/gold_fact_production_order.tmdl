/// One row per production order, with planned and actual dates and yields.
table gold_fact_production_order
	lineageTag: cbcbdd3c-69bb-5aff-8663-a1719e69b415

	measure 'Good Qty' = SUM ( gold_fact_production_order[good_qty] )
		formatString: #,0
		displayFolder: Production
		lineageTag: e9ff6407-9dbc-589f-9654-af9f5a19c492

	measure 'Scrap Qty' = SUM ( gold_fact_production_order[scrap_qty] )
		formatString: #,0
		displayFolder: Production
		lineageTag: ac523738-32e4-5fff-9b3f-494867c2387f

	/// Scrap quantity divided by good plus scrap quantity of ended orders.
	measure 'Scrap Rate %' = DIVIDE ( [Scrap Qty], [Good Qty] + [Scrap Qty] )
		formatString: 0.00%
		displayFolder: Production
		lineageTag: 42cf4f80-45cf-5191-89ac-0c2a77366bed

	/// Scrap at standard cost.
	measure 'Scrap Cost CHF' = SUM ( gold_fact_production_order[scrap_value_chf] )
		formatString: #,0
		displayFolder: Production
		lineageTag: 1b36e664-4b01-52a5-afdb-abe9b7dad337

	measure 'Completed Orders' = CALCULATE ( COUNTROWS ( gold_fact_production_order ), gold_fact_production_order[is_completed] = TRUE () )
		formatString: #,0
		displayFolder: Production
		lineageTag: 9d393f19-99d1-56fc-ace9-c01274973944

	measure 'Plan Attainment %' = DIVIDE ( [Good Qty], CALCULATE ( SUM ( gold_fact_production_order[planned_qty] ), gold_fact_production_order[is_completed] = TRUE () ) )
		formatString: 0.0%
		displayFolder: Production
		lineageTag: 69817c21-83d6-5fd0-91a3-a2976e43ef32

	/// Ended orders finished on or before the planned finish date.
	measure 'Schedule Adherence %' = DIVIDE ( CALCULATE ( COUNTROWS ( gold_fact_production_order ), gold_fact_production_order[is_on_schedule] = TRUE () ), [Completed Orders] )
		formatString: 0.0%
		displayFolder: Production
		lineageTag: 79b1868b-7473-53f0-a8a2-9be2f54df638

	measure 'Avg Cycle Time (days)' = AVERAGE ( gold_fact_production_order[cycle_days] )
		formatString: #,0.0
		displayFolder: Production
		lineageTag: 9baa73ad-5f48-5973-9b42-81d42a95ac55

	measure 'Avg Start Delay (days)' = AVERAGE ( gold_fact_production_order[start_delay_days] )
		formatString: #,0.0
		displayFolder: Production
		lineageTag: 3e6a25c5-6dc8-5af1-837b-5a371fdf890b

