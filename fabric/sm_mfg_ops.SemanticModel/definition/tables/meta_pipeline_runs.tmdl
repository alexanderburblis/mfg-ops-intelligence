/// One row per pipeline stage and attempt.
table meta_pipeline_runs
	lineageTag: ee0a176b-45f2-5a30-b503-cfe87fbaf437

	measure 'Avg Stage Seconds' = AVERAGE ( meta_pipeline_runs[seconds] )
		formatString: #,0.0
		displayFolder: Monitoring
		lineageTag: 53dff92d-8109-5e67-af19-74f389807ac9

	column run_id
		dataType: string
		lineageTag: 181b265d-6be2-557d-8d62-c085c7f00894
