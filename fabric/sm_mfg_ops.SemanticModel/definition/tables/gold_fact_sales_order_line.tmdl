/// One row per sales order line, with delivery outcome (on time, in full).
table gold_fact_sales_order_line
	lineageTag: a81caed3-60f5-5f1f-9a4b-aaa0cd48dc9f

	/// Order value of valid order lines.
	measure 'Revenue CHF' = SUM ( gold_fact_sales_order_line[order_value_chf] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: 46f25a30-8f97-5484-a34a-0af12a2753c1

	/// Same period last year (order date).
	measure 'Revenue PY CHF' = CALCULATE ( [Revenue CHF], SAMEPERIODLASTYEAR ( gold_dim_date[date] ) )
		formatString: #,0
		displayFolder: Sales
		lineageTag: ba70b6c1-56a7-5a8e-bfc3-c4f89f136af0

	measure 'Revenue YoY %' = DIVIDE ( [Revenue CHF] - [Revenue PY CHF], [Revenue PY CHF] )
		formatString: 0.0%
		displayFolder: Sales
		lineageTag: 9b94470b-1424-56b0-89f2-d5bb7af6bfeb

	measure 'Order Lines' = COUNTROWS ( gold_fact_sales_order_line )
		formatString: #,0
		displayFolder: Sales
		lineageTag: a4fcb236-4798-5e42-94ec-511c7bac6f7c

	measure 'Customers with Orders' = DISTINCTCOUNT ( gold_fact_sales_order_line[customer_id] )
		formatString: #,0
		displayFolder: Sales
		lineageTag: a4a7d0b1-3d02-5192-8b1c-d1f1d0b5231f

	measure 'Shipped Lines' = CALCULATE ( COUNTROWS ( gold_fact_sales_order_line ), gold_fact_sales_order_line[is_shipped] = TRUE () )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 8e50c78d-a138-5a50-9d7d-7969a0072783

	/// Shipped lines delivered on or before the requested date and in full, divided by shipped lines.
	measure 'OTIF %' = DIVIDE ( CALCULATE ( COUNTROWS ( gold_fact_sales_order_line ), gold_fact_sales_order_line[is_otif] = TRUE () ), [Shipped Lines] )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: a49971c4-e1a9-5f20-bfda-059c41bbe62d

	/// Service-level target (assumption for the demo).
	measure 'OTIF Target %' = 0.9
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 4a903592-9826-5307-91ec-2f7b5e9efe09

	measure 'OTIF Gap pts' = [OTIF %] - [OTIF Target %]
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Delivery
		lineageTag: e79b1ddb-8965-5e51-a927-28d12327acdf

	measure 'On-Time %' = DIVIDE ( CALCULATE ( COUNTROWS ( gold_fact_sales_order_line ), gold_fact_sales_order_line[is_on_time] = TRUE () ), [Shipped Lines] )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: ed88e9e5-5f01-54a1-975c-68dfa7611c89

	measure 'In-Full %' = DIVIDE ( CALCULATE ( COUNTROWS ( gold_fact_sales_order_line ), gold_fact_sales_order_line[is_in_full] = TRUE (), gold_fact_sales_order_line[is_shipped] = TRUE () ), [Shipped Lines] )
		formatString: 0.0%
		displayFolder: Delivery
		lineageTag: 8e176192-b960-53f1-982c-469d168647fd

	measure 'Avg Days Late (late lines)' = CALCULATE ( AVERAGE ( gold_fact_sales_order_line[days_late] ), gold_fact_sales_order_line[days_late] > 0 )
		formatString: #,0.0
		displayFolder: Delivery
		lineageTag: dad97ca3-953d-562f-97a2-b79ddd8af185

	measure 'Open Order Backlog CHF' = CALCULATE ( [Revenue CHF], gold_fact_sales_order_line[is_shipped] = FALSE () )
		formatString: #,0
		displayFolder: Delivery
		lineageTag: 73d9042a-27ff-5d5f-aea8-fb2e5207d947

