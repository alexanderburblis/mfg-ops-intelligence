DEFINE
	MEASURE 'gold_fact_sales_order_line'[Revenue CHF] = SUM ( gold_fact_sales_order_line[order_value_chf] )
	MEASURE 'gold_fact_sales_order_line'[Shipped Lines] = CALCULATE ( COUNTROWS ( gold_fact_sales_order_line ), gold_fact_sales_order_line[is_shipped] = TRUE () )
	MEASURE 'gold_fact_sales_order_line'[OTIF %] = DIVIDE ( CALCULATE ( COUNTROWS ( gold_fact_sales_order_line ), gold_fact_sales_order_line[is_otif] = TRUE () ), [Shipped Lines] )
	MEASURE 'gold_fact_sales_order_line'[On-Time Delivery %] = DIVIDE ( CALCULATE ( COUNTROWS ( gold_fact_sales_order_line ), gold_fact_sales_order_line[is_on_time] = TRUE () ), [Shipped Lines] )
	MEASURE 'gold_fact_sales_order_line'[Avg Days Late (late lines)] = CALCULATE ( AVERAGE ( gold_fact_sales_order_line[days_late] ), gold_fact_sales_order_line[days_late] > 0 )
	MEASURE 'gold_fact_sales_order_line'[Open Order Backlog CHF] = CALCULATE ( [Revenue CHF], gold_fact_sales_order_line[is_shipped] = FALSE () )
	MEASURE 'gold_fact_production_order'[Good Qty] = SUM ( gold_fact_production_order[good_qty] )
	MEASURE 'gold_fact_production_order'[Scrap Qty] = SUM ( gold_fact_production_order[scrap_qty] )
	MEASURE 'gold_fact_production_order'[Scrap Rate %] = DIVIDE ( [Scrap Qty], [Good Qty] + [Scrap Qty] )
	MEASURE 'gold_fact_production_order'[Scrap Cost CHF] = SUM ( gold_fact_production_order[scrap_value_chf] )
	MEASURE 'gold_fact_production_order'[Plan Attainment %] = DIVIDE ( [Good Qty], CALCULATE ( SUM ( gold_fact_production_order[planned_qty] ), gold_fact_production_order[is_completed] = TRUE () ) )
	MEASURE 'gold_fact_production_order'[Schedule Adherence %] = DIVIDE ( CALCULATE ( COUNTROWS ( gold_fact_production_order ), gold_fact_production_order[is_on_schedule] = TRUE () ), CALCULATE ( COUNTROWS ( gold_fact_production_order ), gold_fact_production_order[is_completed] = TRUE () ) )
	MEASURE 'gold_fact_production_order'[Avg Cycle Time (days)] = AVERAGE ( gold_fact_production_order[cycle_days] )
	MEASURE 'gold_fact_inventory_snapshot'[Stock Value CHF] = VAR SnapDate = MAX ( gold_fact_inventory_snapshot[snapshot_date] ) RETURN CALCULATE ( SUM ( gold_fact_inventory_snapshot[stock_value_chf] ), gold_fact_inventory_snapshot[snapshot_date] = SnapDate )
	MEASURE 'gold_fact_inventory_snapshot'[Items Below Safety Stock] = VAR SnapDate = MAX ( gold_fact_inventory_snapshot[snapshot_date] ) RETURN CALCULATE ( COUNTROWS ( gold_fact_inventory_snapshot ), gold_fact_inventory_snapshot[snapshot_date] = SnapDate, gold_fact_inventory_snapshot[is_below_safety_stock] = TRUE () )
	MEASURE 'gold_fact_inventory_snapshot'[Median Days of Coverage] = VAR SnapDate = MAX ( gold_fact_inventory_snapshot[snapshot_date] ) RETURN CALCULATE ( MEDIAN ( gold_fact_inventory_snapshot[days_of_coverage] ), gold_fact_inventory_snapshot[snapshot_date] = SnapDate )
	MEASURE 'gold_fact_purchase_order'[Supplier On-Time %] = DIVIDE ( CALCULATE ( COUNTROWS ( gold_fact_purchase_order ), gold_fact_purchase_order[is_on_time] = TRUE () ), CALCULATE ( COUNTROWS ( gold_fact_purchase_order ), gold_fact_purchase_order[is_received] = TRUE () ) )
	MEASURE 'gold_dq_results'[Latest DQ Run] = MAX ( gold_dq_results[run_ts] )
	MEASURE 'gold_dq_results'[Rows Checked (latest run)] = VAR LastRun = MAXX ( ALL ( gold_dq_results ), gold_dq_results[run_id] ) RETURN CALCULATE ( SUM ( gold_dq_results[rows_checked] ), gold_dq_results[run_id] = LastRun )
	MEASURE 'gold_dq_results'[Rows Failed (latest run)] = VAR LastRun = MAXX ( ALL ( gold_dq_results ), gold_dq_results[run_id] ) RETURN CALCULATE ( SUM ( gold_dq_results[rows_failed] ), gold_dq_results[run_id] = LastRun )
	MEASURE 'gold_dq_results'[DQ Pass Rate %] = 1 - DIVIDE ( [Rows Failed (latest run)], [Rows Checked (latest run)] )
	MEASURE 'gold_dq_results'[Rules Failing (latest run)] = VAR LastRun = MAXX ( ALL ( gold_dq_results ), gold_dq_results[run_id] ) RETURN CALCULATE ( COUNTROWS ( gold_dq_results ), gold_dq_results[run_id] = LastRun, gold_dq_results[rows_failed] > 0 )
EVALUATE
	ROW ( "Revenue CHF", [Revenue CHF], "OTIF %", [OTIF %], "Scrap Rate %", [Scrap Rate %], "Schedule Adherence %", [Schedule Adherence %], "Stock Value CHF", [Stock Value CHF], "Supplier On-Time %", [Supplier On-Time %], "DQ Pass Rate %", [DQ Pass Rate %] )
