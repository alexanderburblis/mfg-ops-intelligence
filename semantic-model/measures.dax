// Semantic model measures: Manufacturing Operations Intelligence
// Tables are the gold Delta tables in lakehouse lh_mfg_ops, read in Direct Lake mode.
// Store all measures in a dedicated table "_Measures", grouped into display folders.

// ---------------------------------------------------------------- Sales & delivery
Revenue CHF =
SUM ( gold_fact_sales_order_line[order_value_chf] )

Shipped Lines =
CALCULATE ( COUNTROWS ( gold_fact_sales_order_line ), gold_fact_sales_order_line[is_shipped] = TRUE () )

OTIF % =
// On time AND in full, measured on shipped lines only
DIVIDE (
    CALCULATE ( COUNTROWS ( gold_fact_sales_order_line ), gold_fact_sales_order_line[is_otif] = TRUE () ),
    [Shipped Lines]
)

On-Time Delivery % =
DIVIDE (
    CALCULATE ( COUNTROWS ( gold_fact_sales_order_line ), gold_fact_sales_order_line[is_on_time] = TRUE () ),
    [Shipped Lines]
)

Avg Days Late (late lines) =
CALCULATE (
    AVERAGE ( gold_fact_sales_order_line[days_late] ),
    gold_fact_sales_order_line[days_late] > 0
)

Open Order Backlog CHF =
CALCULATE ( [Revenue CHF], gold_fact_sales_order_line[is_shipped] = FALSE () )

// ---------------------------------------------------------------- Production
Good Qty =
SUM ( gold_fact_production_order[good_qty] )

Scrap Qty =
SUM ( gold_fact_production_order[scrap_qty] )

Scrap Rate % =
DIVIDE ( [Scrap Qty], [Good Qty] + [Scrap Qty] )

Scrap Cost CHF =
SUM ( gold_fact_production_order[scrap_value_chf] )

Plan Attainment % =
// Good output against planned quantity of completed orders
DIVIDE (
    [Good Qty],
    CALCULATE ( SUM ( gold_fact_production_order[planned_qty] ), gold_fact_production_order[is_completed] = TRUE () )
)

Schedule Adherence % =
DIVIDE (
    CALCULATE ( COUNTROWS ( gold_fact_production_order ), gold_fact_production_order[is_on_schedule] = TRUE () ),
    CALCULATE ( COUNTROWS ( gold_fact_production_order ), gold_fact_production_order[is_completed] = TRUE () )
)

Avg Cycle Time (days) =
AVERAGE ( gold_fact_production_order[cycle_days] )

// ---------------------------------------------------------------- Inventory & MRP
// Inventory is a snapshot: never sum across dates, take the last snapshot in the filter context.
Last Snapshot Date =
CALCULATE ( MAX ( gold_fact_inventory_snapshot[snapshot_date] ), ALLSELECTED ( gold_dim_date ) )

Stock Value CHF =
VAR SnapDate = MAX ( gold_fact_inventory_snapshot[snapshot_date] )
RETURN
    CALCULATE ( SUM ( gold_fact_inventory_snapshot[stock_value_chf] ), gold_fact_inventory_snapshot[snapshot_date] = SnapDate )

Items Below Safety Stock =
VAR SnapDate = MAX ( gold_fact_inventory_snapshot[snapshot_date] )
RETURN
    CALCULATE (
        COUNTROWS ( gold_fact_inventory_snapshot ),
        gold_fact_inventory_snapshot[snapshot_date] = SnapDate,
        gold_fact_inventory_snapshot[is_below_safety_stock] = TRUE ()
    )

Median Days of Coverage =
VAR SnapDate = MAX ( gold_fact_inventory_snapshot[snapshot_date] )
RETURN
    CALCULATE ( MEDIAN ( gold_fact_inventory_snapshot[days_of_coverage] ), gold_fact_inventory_snapshot[snapshot_date] = SnapDate )

// ---------------------------------------------------------------- Purchasing
Supplier On-Time % =
DIVIDE (
    CALCULATE ( COUNTROWS ( gold_fact_purchase_order ), gold_fact_purchase_order[is_on_time] = TRUE () ),
    CALCULATE ( COUNTROWS ( gold_fact_purchase_order ), gold_fact_purchase_order[is_received] = TRUE () )
)

// ---------------------------------------------------------------- Data quality
Latest DQ Run =
MAX ( gold_dq_results[run_ts] )

Rows Checked (latest run) =
CALCULATE ( SUM ( gold_dq_results[rows_checked] ), gold_dq_results[run_ts] = [Latest DQ Run] )

Rows Failed (latest run) =
CALCULATE ( SUM ( gold_dq_results[rows_failed] ), gold_dq_results[run_ts] = [Latest DQ Run] )

DQ Pass Rate % =
1 - DIVIDE ( [Rows Failed (latest run)], [Rows Checked (latest run)] )

Rules Failing (latest run) =
CALCULATE (
    COUNTROWS ( gold_dq_results ),
    gold_dq_results[run_ts] = [Latest DQ Run],
    gold_dq_results[rows_failed] > 0
)

// ---------------------------------------------------------------- Time intelligence (pattern)
Revenue CHF PY =
CALCULATE ( [Revenue CHF], SAMEPERIODLASTYEAR ( gold_dim_date[date] ) )

Revenue CHF YoY % =
DIVIDE ( [Revenue CHF] - [Revenue CHF PY], [Revenue CHF PY] )

OTIF % PY =
CALCULATE ( [OTIF %], SAMEPERIODLASTYEAR ( gold_dim_date[date] ) )
